{
  "name": "practical-12-cicd-pipeline",
  "version": "1.0.0",
  "description": "Practical 12: CI/CD Pipeline with GitHub Actions and Automated Testing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:broken": "jest tests/broken.test.js --testPathIgnorePatterns '/node_modules/' --runInBand --detectOpenHandles --forceExit",
    "lint": "eslint . --ext .js --ignore-pattern node_modules/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 10000,
    "verbose": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "broken.test.js"
    ]
  }
}
